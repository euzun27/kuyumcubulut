{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuyumcu",
  "compatibility_date": "2026-09-08",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  // Sunucu kodu veritabanına yakın çalışsın: her ekran birkaç sorgu yaptığı için
  // dükkândan uzak veritabanına her sorguda gidip gelmek yerine tek gidiş-dönüş olur.
  "placement": { "mode": "smart" },
  "vars": {
    "APP_TZ": "Europe/Istanbul"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuyumcu-production",
      "database_id": "fb9f72e8-ef25-4793-8d12-04d96721d1b9",
      "migrations_dir": "migrations"
    }
  ]
}
